{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.RoaminS/memory-os-ai",
  "title": "Memory OS AI",
  "description": "Local project memory through a stdio relay. Requires an installed, authenticated shared v4 service.",
  "websiteUrl": "https://pypi.org/project/memory-os-ai/",
  "repository": {
    "url": "https://github.com/RoaminS/Memory-os-ai",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/RoaminS/Memory-os-ai/main/docs/assets/memory-os-ai-logo.svg",
      "mimeType": "image/svg+xml",
      "sizes": ["any"]
    },
    {
      "src": "https://raw.githubusercontent.com/RoaminS/Memory-os-ai/main/docs/assets/memory-os-ai-logo-512.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    }
  ],
  "version": "4.1.3",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "memory-os-ai",
      "version": "4.1.3",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "memory-os-ai[ops,brief]==4.1.3"
        },
        {
          "type": "positional",
          "value": "memory-os-relay"
        }
      ],
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "MEMORY_V4_TOKEN_FILE",
          "description": "Absolute path to the existing private 0600 service token file; never paste the token value.",
          "format": "filepath",
          "isRequired": true,
          "isSecret": false
        },
        {
          "name": "MEMORY_V4_URL",
          "description": "Existing authenticated loopback service endpoint; the relay does not start a server.",
          "default": "http://127.0.0.1:8765/mcp/",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "publication_ready": true,
      "status": "published-only-if-P9-and-gate-P10a-pass-for-4.1.3-results-in-4.1.3-release-P9-manifest-and-proof-complement",
      "launch": {
        "command": "memory-os-relay",
        "requires_existing_shared_service": true,
        "consumer_argument_convention": "runtimeArguments before the consumer-appended package identifier; trailing identifier ignored by relay.main",
        "manual_pinned_command": "uvx --from memory-os-ai[ops,brief]==4.1.3 memory-os-relay"
      },
      "public_source_status": "github-RoaminS-active"
    }
  }
}
